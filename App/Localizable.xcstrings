      }
    },
    "A writer or a manner, for example Dovlatov or a noir detective. Empty keeps your last choice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A writer or a manner, for example Dovlatov or a noir detective. Empty keeps your last choice."
