    "Anthropic writes the story. ElevenLabs reads it aloud, and OpenAI reads it if ElevenLabs is unavailable. Turn this off and Baika asks again before the next story.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic writes the story. ElevenLabs reads it aloud, and OpenAI reads it if ElevenLabs is unavailable. Turn this off and Baika asks again before the next story."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Историю пишет Anthropic. Вслух читает ElevenLabs, а если он недоступен — OpenAI. Выключите, и Байка спросит снова перед следующей историей."
          }
        }
      }
    },
    "Apple did not return an identity token.": {
      "localizations": {
