  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baika"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Байка"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baika uses the microphone when you dictate the topic of a story."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Байка использует микрофон, когда вы диктуете тему истории."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baika turns your spoken topic into text so it can write the story."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Байка превращает вашу речь в текст, чтобы написать историю."
          }
        }
      }
    }
  },
  "version": "1.0"
}
